+/*
+ * Kernir patch 0021: a directory, and the Rockridge continuation areas (CE)
+ * its records point at, are read whole before the directory's first entry
+ * is returned, so no limit of the caller's comes in time. Upstream read
+ * ahead a directory's whole extent at once, its size a 32-bit on-disk value
+ * checked only against the volume size the image declares itself: a 296 KiB
+ * image claiming a 4 GiB directory had the read-ahead copy buffer malloc
+ * 4 GiB before EOF (choose_volume did the same with the root's size). The
+ * extent is now read and parsed one logical block at a time, so a short
+ * file stops at EOF with bounded memory, and choose_volume reads only the
+ * root's directory record (at most 255 bytes).
+ *
+ * Every directory record, the root included, counts against the entry
+ * limit before parse_file_info allocates it (kernir_iso_count). Multi-extent
+ * parts, CL placeholders and a hidden rr_moved count too, though the caller
+ * sees no header of theirs, so such an image can be refused slightly before
+ * the caller's own count would refuse it.
+ *
+ * Several records' CE entries may point at one chain of CE blocks, and
+ * read_CE then parses every block of it once for each of those records,
+ * appending its NM and SL text to every one of their names: N records and
+ * k blocks made N x k x 1.75 KB of names from k x 2 KB of file. Each
+ * record's name and link target are charged after parse_file_info and
+ * after each continuation area (kernir_iso_charge, by the most they have
+ * held: an NM without CONTINUE empties the name and starts it again, so a
+ * name can shrink, and the charge is then not given back): one over
+ * KERNIR_ISO_NAME_BYTES, or all of them over the names limit
+ * (__archive_read_kernir_names_allowance of the records so far), is
+ * refused. A chain whose areas grow no name (padding, unknown entries, or
+ * an NM without CONTINUE refilling the same name) still cost N x k parses,
+ * CPU quadratic in the image's size: each record's pass over each area is
+ * charged too, by the area's size, before it is parsed
+ * (kernir_iso_charge_ce, a total of its own held to the same allowance plus
+ * the bytes read so far, current_position: a valid image's distinct areas,
+ * such as xorriso's AAIP ACL and xattr entries, always fit in those, and a
+ * shared chain still stays linear in the image's size; refused with the
+ * same message). All of these are ARCHIVE_FATAL with
+ * their own messages, which Kernir maps to its limits.
+ */
+#define KERNIR_ISO_NAME_BYTES 65536
+
+static int
+kernir_iso_refuse(struct archive_read *a, const char *msg)
+{
+	archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT, "%s", msg);
+	return (ARCHIVE_FATAL);
+}
+
+static int
+kernir_iso_count(struct archive_read *a)
+{
+	struct iso9660 *iso9660 = a->format->data;
+
+	if (++iso9660->kernir_entries > a->kernir_max_entries)
+		return (kernir_iso_refuse(a,
+		    "ISO9660 image has more entries than the entry limit"));
+	return (ARCHIVE_OK);
+}
+
+static int
+kernir_iso_charge(struct archive_read *a, struct file_info *file)
+{
+	struct iso9660 *iso9660 = a->format->data;
+	uint64_t held;
+
+	if (archive_strlen(&file->name) > KERNIR_ISO_NAME_BYTES)
+		return (kernir_iso_refuse(a,
+		    "ISO9660 entry name is longer than 65536 bytes"));
+	if (archive_strlen(&file->symlink) > KERNIR_ISO_NAME_BYTES)
+		return (kernir_iso_refuse(a,
+		    "ISO9660 link target is longer than 65536 bytes"));
+	held = (uint64_t)archive_strlen(&file->name) +
+	    archive_strlen(&file->symlink);
+	if (held > file->kernir_charged) {
+		iso9660->kernir_name_bytes += held - file->kernir_charged;
+		file->kernir_charged = held;
+	}
+	if (iso9660->kernir_name_bytes >
+	    __archive_read_kernir_names_allowance(a, iso9660->kernir_entries))
+		return (kernir_iso_refuse(a, "ISO9660 entry names and link "
+		    "targets take more than the names limit"));
+	return (ARCHIVE_OK);
+}
+
+static int
+kernir_iso_charge_ce(struct archive_read *a, uint32_t size)
+{
+	struct iso9660 *iso9660 = a->format->data;
+	uint64_t bound;
+
+	if (iso9660->kernir_ce_bytes > UINT64_MAX - size)
+		iso9660->kernir_ce_bytes = UINT64_MAX;
+	else
+		iso9660->kernir_ce_bytes += size;
+	/* A valid image's distinct areas lie in the bytes read so far. */
+	bound = __archive_read_kernir_names_allowance(a,
+	    iso9660->kernir_entries);
+	if (bound > UINT64_MAX - iso9660->current_position)
+		bound = UINT64_MAX;
+	else
+		bound += iso9660->current_position;
+	if (iso9660->kernir_ce_bytes > bound)
+		return (kernir_iso_refuse(a, "ISO9660 entry names and link "
+		    "targets take more than the names limit"));
+	return (ARCHIVE_OK);
 }
 
