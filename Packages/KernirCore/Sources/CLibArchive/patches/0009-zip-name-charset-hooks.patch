--- a/libarchive/archive_write_set_format_zip.c
+++ b/libarchive/archive_write_set_format_zip.c
@@ -74,6 +74,7 @@
 #include "archive_time_private.h"
 #include "archive_write_private.h"
 #include "archive_write_set_format_private.h"
+#include "kernir_names.h"		/* Kernir patch 0009 */
 
 
 
@@ -784,6 +785,8 @@
 	int ret, ret2 = ARCHIVE_OK;
 	mode_t type;
 	int version_needed = 10;
+	/* Kernir patch 0009: taken by _archive_write_header. */
+	int raw_name = a->kernir_zip_raw_name;
 #define MIN_VERSION_NEEDED(x) do { if (version_needed < x) { version_needed = x; } } while (0)
 
 	/* Sanity check. */
@@ -877,7 +880,9 @@
 		return (ARCHIVE_FATAL);
 	}
 
-	{
+	/* Kernir patch 0009: in raw-name mode the MBS pathname and symlink
+	 * are stored verbatim. */
+	if (raw_name == 0) {
 		const char *p;
 		size_t len;
 
@@ -928,7 +933,11 @@
 	}
 
 	/* If filename isn't ASCII and we can use UTF-8, set the UTF-8 flag. */
-	if (!is_all_ascii(archive_entry_pathname(zip->entry))) {
+	if (raw_name != 0) {
+		/* Kernir patch 0009: the caller's flag, verbatim. */
+		if (raw_name == 2)
+			zip->entry_flags |= ZIP_ENTRY_FLAG_UTF8_NAME;
+	} else if (!is_all_ascii(archive_entry_pathname(zip->entry))) {
 		if (zip->opt_sconv != NULL) {
 			if (strcmp(archive_string_conversion_charset_name(
 					zip->opt_sconv), "UTF-8") == 0)
@@ -2527,4 +2536,25 @@
 		return (0);
 	archive_hmac_sha1_cleanup(&hctx);
 	return (1);
+}
+
+/*
+ * Kernir patch 0009: the next archive_write_header stores the entry's MBS
+ * pathname and symlink verbatim (no conversion, no "Can't translate"
+ * warning) and sets the UTF-8 flag iff utf8_flag != 0.
+ */
+int
+kernir_write_zip_next_name_raw(struct archive *_a, int utf8_flag)
+{
+	struct archive_write *a = (struct archive_write *)_a;
+
+	if (_a == NULL || _a->magic != ARCHIVE_WRITE_MAGIC ||
+	    a->format_write_header != archive_write_zip_header) {
+		if (_a != NULL)
+			archive_set_error(_a, ARCHIVE_ERRNO_MISC,
+			    "Raw entry names need a zip writer");
+		return (ARCHIVE_FATAL);
+	}
+	a->kernir_zip_raw_request = utf8_flag ? 2 : 1;
+	return (ARCHIVE_OK);
 }
--- /dev/null
+++ b/include/kernir_names.h
@@ -0,0 +1,18 @@
+/* Kernir patch 0009 (patches/0009-zip-name-charset-hooks.patch): zip entry-name hooks.
+ * Implemented in libarchive/archive_read_support_format_zip.c and archive_write_set_format_zip.c. */
+#ifndef KERNIR_NAMES_H
+#define KERNIR_NAMES_H
+
+struct archive;
+
+/* 1: the current zip entry's name was declared Unicode (bit 11, or an Info-ZIP Unicode Path field 0x7075 was used).
+   0: stored in an undeclared code page. -1: the archive is not being read as zip. */
+int kernir_read_zip_entry_name_declared(struct archive *a);
+
+/* For the next archive_write_header only (zip writer): write the entry's MBS pathname and symlink bytes
+   verbatim (no charset conversion, no "Can't translate" warning) and set bit 11 iff utf8_flag != 0.
+   Returns ARCHIVE_OK, or ARCHIVE_FATAL if the writer is not zip.
+   The flag resets at the start of every archive_write_header, whether that header succeeds or fails. */
+int kernir_write_zip_next_name_raw(struct archive *a, int utf8_flag);
+
+#endif
