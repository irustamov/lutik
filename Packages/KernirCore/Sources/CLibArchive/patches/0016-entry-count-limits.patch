+
+/*
+ * Kernir patch 0016: the limits the 7zip and xar readers hold a whole
+ * header or TOC to (kernir_names.h).
+ */
+int
+kernir_read_set_name_limits(struct archive *_a, uint64_t max_entries,
+    uint64_t names_bytes, uint64_t name_bytes_per_entry)
+{
+	struct archive_read *a = (struct archive_read *)_a;
+
+	archive_check_magic(_a, ARCHIVE_READ_MAGIC, ARCHIVE_STATE_NEW,
+	    "kernir_read_set_name_limits");
+	a->kernir_max_entries = max_entries;
+	a->kernir_names_bytes = names_bytes;
+	a->kernir_name_bytes_per_entry = name_bytes_per_entry;
+	return (ARCHIVE_OK);
+}
+
+int
+kernir_read_get_name_limits(struct archive *_a, uint64_t *max_entries,
+    uint64_t *names_bytes, uint64_t *name_bytes_per_entry)
+{
+	struct archive_read *a = (struct archive_read *)_a;
+
+	archive_check_magic(_a, ARCHIVE_READ_MAGIC, ARCHIVE_STATE_ANY,
+	    "kernir_read_get_name_limits");
+	*max_entries = a->kernir_max_entries;
+	*names_bytes = a->kernir_names_bytes;
+	*name_bytes_per_entry = a->kernir_name_bytes_per_entry;
+	return (ARCHIVE_OK);
+}
+
+uint64_t
+__archive_read_kernir_names_allowance(struct archive_read *a,
+    uint64_t entries)
+{
+	uint64_t per = a->kernir_name_bytes_per_entry;
+
+	if (per != 0 && entries > UINT64_MAX / per)
+		return (UINT64_MAX);
+	return (per * entries > a->kernir_names_bytes ?
+	    per * entries : a->kernir_names_bytes);
 }
 
