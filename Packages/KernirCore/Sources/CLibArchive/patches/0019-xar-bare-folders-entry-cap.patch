@@ -331,14 +331,27 @@
 /*
  * Kernir patch 0016: the names total grows with the <file> elements so far
  * (__archive_read_kernir_names_allowance, 256 MiB or 512 bytes each by
- * default), and the TOC may hold at most kernir_max_entries <file> elements
- * (each one is allocated before Kernir sees any) and as many <ea> elements,
- * and at most KERNIR_XAR_EAS_PER_FILE <ea> in one <file>: xattr_new keeps
+ * default), and listed <file> elements over kernir_max_entries are refused
+ * (patch 0019; any <file> over 2 x kernir_max_entries too, bounded memory:
+ * each one is allocated before Kernir sees any), as are <ea> elements over
+ * kernir_max_entries, and at most KERNIR_XAR_EAS_PER_FILE <ea> in one <file>: xattr_new keeps
  * them sorted by id, walking the file's list for each one, so a file's
  * <ea> elements cost time that grows with the square of their count (20,000
  * of them in a 47 KB xar took 0.6 s). A real file has a few dozen at most.
  */
 #define KERNIR_XAR_EAS_PER_FILE	1024
+/*
+ * Kernir patch 0019: a bare folder (a directory <file> with only a name and
+ * a type) is never returned as a header, so it does not count against
+ * kernir_max_entries: the <file> elements read_header returns do, counted
+ * at </file> once their has flags are known, as the caller counts headers.
+ * Each <file> is still allocated as it opens, so all of them, bare folders
+ * included, are held to twice kernir_max_entries (saturated), and 0016's
+ * names total grows with at most kernir_max_entries of them.
+ */
+#define kernir_xar_listed(file)						\
+	(((file)->mode & AE_IFMT) != AE_IFDIR ||			\
+	    (file)->has != (HAS_PATHNAME | HAS_TYPE))
 
