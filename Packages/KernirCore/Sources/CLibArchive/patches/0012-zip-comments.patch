+/*
+ * Kernir patch 0012: the current entry's central-directory comment. 1 with
+ * *bytes and *length set (length 0: no comment) when the seekable reader
+ * read the entry from the central directory; 0 when the entry has no
+ * central-directory record here (the streaming reader, or no current
+ * entry); -1 when the archive is not being read as zip.
+ */
+int
+kernir_read_zip_entry_comment(struct archive *_a, const void **bytes,
+    size_t *length)
+{
+	struct archive_read *a = (struct archive_read *)_a;
+	struct zip *zip;
+
+	if (bytes != NULL)
+		*bytes = NULL;
+	if (length != NULL)
+		*length = 0;
+	if (_a == NULL || _a->magic != ARCHIVE_READ_MAGIC ||
+	    a->format == NULL ||
+	    (a->format->read_header !=
+	     archive_read_format_zip_streamable_read_header &&
+	     a->format->read_header !=
+	     archive_read_format_zip_seekable_read_header))
+		return (-1);
+	if (a->format->read_header !=
+	    archive_read_format_zip_seekable_read_header)
+		return (0);
+	zip = (struct zip *)a->format->data;
+	if (zip->entry == NULL ||
+	    (zip->entry->flags & LA_FROM_CENTRAL_DIRECTORY) == 0)
+		return (0);
+	if (bytes != NULL)
+		*bytes = zip->entry->kernir_comment.s;
+	if (length != NULL)
+		*length = zip->entry->kernir_comment.length;
+	return (1);
+}
