+/*
+ * Kernir patch 0012: the next archive_write_header's entry gets these bytes
+ * as its central-directory comment, verbatim (length 0: no comment).
+ */
+int
+kernir_write_zip_next_comment(struct archive *_a, const void *bytes,
+    size_t length)
+{
+	struct archive_write *a = (struct archive_write *)_a;
+
+	if (_a == NULL || _a->magic != ARCHIVE_WRITE_MAGIC ||
+	    a->format_write_header != archive_write_zip_header) {
+		if (_a != NULL)
+			archive_set_error(_a, ARCHIVE_ERRNO_MISC,
+			    "Entry comments need a zip writer");
+		return (ARCHIVE_FATAL);
+	}
+	if (length > 0xffff || (length > 0 && bytes == NULL)) {
+		archive_set_error(_a, ARCHIVE_ERRNO_MISC,
+		    "Invalid zip entry comment");
+		return (ARCHIVE_FATAL);
+	}
+	archive_string_empty(&a->kernir_zip_comment_request);
+	if (length > 0 && archive_array_append(&a->kernir_zip_comment_request,
+	    bytes, length) == NULL) {
+		archive_set_error(_a, ENOMEM, "Can't allocate zip data");
+		return (ARCHIVE_FATAL);
+	}
+	return (ARCHIVE_OK);
+}
+
+/*
+ * Kernir patch 0012: the archive comment written after the
+ * end-of-central-directory record at close, verbatim (length 0: none).
+ */
+int
+kernir_write_zip_archive_comment(struct archive *_a, const void *bytes,
+    size_t length)
+{
+	struct archive_write *a = (struct archive_write *)_a;
+	struct zip *zip;
+
+	if (_a == NULL || _a->magic != ARCHIVE_WRITE_MAGIC ||
+	    a->format_write_header != archive_write_zip_header) {
+		if (_a != NULL)
+			archive_set_error(_a, ARCHIVE_ERRNO_MISC,
+			    "Archive comments need a zip writer");
+		return (ARCHIVE_FATAL);
+	}
+	if (length > 0xffff || (length > 0 && bytes == NULL)) {
+		archive_set_error(_a, ARCHIVE_ERRNO_MISC,
+		    "Invalid zip archive comment");
+		return (ARCHIVE_FATAL);
+	}
+	zip = (struct zip *)a->format_data;
+	archive_string_empty(&zip->kernir_archive_comment);
+	if (length > 0 && archive_array_append(&zip->kernir_archive_comment,
+	    bytes, length) == NULL) {
+		archive_set_error(_a, ENOMEM, "Can't allocate zip data");
+		return (ARCHIVE_FATAL);
+	}
+	return (ARCHIVE_OK);
+}
