+/*
+ * Kernir patch 0015: refuse the TOC with ARCHIVE_ERRNO_FILE_FORMAT and
+ * msg. read_toc sets the archive format only once the TOC is read; set it
+ * here, so the caller sees a damaged xar rather than an unknown format.
+ */
+static int
+kernir_xar_refuse(struct archive_read *a, const char *msg)
+{
+	archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT, "%s", msg);
+	a->archive.archive_format = ARCHIVE_FORMAT_XAR;
+	a->archive.archive_format_name = "xar";
+	return (ARCHIVE_FATAL);
+}
