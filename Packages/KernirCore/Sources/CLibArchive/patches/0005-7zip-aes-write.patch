+/*
+ * Kernir patch 0005: starts a folder's 7zAES stage and fills its coder:
+ * key cost 2^19 and no salt, so one key (derived once) serves every
+ * folder; a fresh random 16-byte IV per folder (CCRandomGenerateBytes).
+ * kernir_7zaes_encode_props needs salt_size <= 16 and writes a 16-byte
+ * IV: 18 bytes here.
+ */
+static int
+aes_start(struct archive_write *a, struct coder *coder)
+{
+	struct _7zip *zip = a->format_data;
+	struct kernir_7zaes_params p;
+	uint8_t props[34];
+	size_t n;
 
+	memset(&p, 0, sizeof(p));
+	p.cycles_power = _7Z_AES_CYCLES_POWER;
+	if (!zip->aes_have_key) {
+		const char *pass = __archive_write_get_passphrase(a);
+		if (pass == NULL) {
+			archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+			    "Encryption needs passphrase");
+			return (ARCHIVE_FATAL);
+		}
+		if (kernir_7zaes_derive_key(&p, pass, zip->aes_key) != 0) {
+			archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+			    "Can't derive the 7zAES key");
+			return (ARCHIVE_FATAL);
+		}
+		zip->aes_have_key = 1;
+	}
+	if (CCRandomGenerateBytes(p.iv, sizeof(p.iv)) != kCCSuccess) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+		    "Can't generate a 7zAES IV");
+		return (ARCHIVE_FATAL);
+	}
+	n = kernir_7zaes_encode_props(&p, props);
+	free(coder->props);
+	coder->props = malloc(n);
+	if (coder->props == NULL) {
+		coder->prop_size = 0;
+		archive_set_error(&a->archive, ENOMEM, "Can't allocate memory");
+		return (ARCHIVE_FATAL);
+	}
+	memcpy(coder->props, props, n);
+	coder->prop_size = n;
+	coder->codec = _7Z_AES;
+	coder->unpack_size = 0;
+	kernir_7zaes_cbc_release(&zip->aes_cbc);
+	if (kernir_7zaes_cbc_init(&zip->aes_cbc, 1, zip->aes_key, p.iv) != 0) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+		    "Can't start AES-256-CBC");
+		return (ARCHIVE_FATAL);
+	}
+	return (ARCHIVE_OK);
+}
+
+/*
+ * Kernir patch 0005: encrypts wbuff[0, *len) in place when a 7zAES stage
+ * is running. `last` ends the folder: its final partial block is
+ * zero-padded (7-Zip's convention; the compressor's unpack size bounds
+ * the read) and *len grows to the multiple of 16 that gets written.
+ * wbuff's size is a multiple of 16, so the padding always fits.
+ */
+static int
+aes_wbuff(struct archive_write *a, size_t *len, int last)
+{
+	struct _7zip *zip = a->format_data;
+	size_t n = *len;
+
+	if (zip->aes_cbc.ref == NULL)
+		return (ARCHIVE_OK);
+	if (last && n % KERNIR_7ZAES_BLOCK_SIZE) {
+		size_t pad = KERNIR_7ZAES_BLOCK_SIZE - n % KERNIR_7ZAES_BLOCK_SIZE;
+		memset(zip->wbuff + n, 0, pad);
+		n += pad;
+	}
+	if (kernir_7zaes_cbc_update(&zip->aes_cbc, zip->wbuff, n,
+	    zip->wbuff) != 0) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+		    "AES-256-CBC failed");
+		return (ARCHIVE_FATAL);
+	}
+	*len = n;
+	if (last)
+		kernir_7zaes_cbc_release(&zip->aes_cbc);
+	return (ARCHIVE_OK);
+}
