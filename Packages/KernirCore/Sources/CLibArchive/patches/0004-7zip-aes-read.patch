+/*
+ * Kernir patch 0004: 7zAES (06F10701) read support.
+ *
+ * An AES coder takes one packed stream and feeds one other coder. Rather
+ * than a coder of its own, it becomes a decryption stage on that packed
+ * stream: kernir_aes_setup_folder() records the key and IV per packed
+ * stream and drops the coder from a copy of the folder, so the rest of
+ * setup_decode_folder() sees [LZMA2], [BCJ, LZMA2] or the usual four-coder
+ * BCJ2 chain. seek_pack() starts AES-256-CBC on each encrypted stream, and
+ * extract_pack_stream()/ppmd_read() read it through a decrypted buffer of
+ * at most 64 KiB plus one block; ciphertext never reaches a caller.
+ */
+
+static void
+kernir_aes_wipe(void *p, size_t n)
+{
+	if (p != NULL && n > 0)
+		memset_s(p, n, 0, n);
+}
+
+static void
+kernir_aes_stream_stop(struct _7zip *zip)
+{
+	if (zip->aes_active) {
+		/* Unconsumed bytes were decrypted ones of this stream. */
+		zip->pack_stream_bytes_unconsumed = 0;
+		zip->aes_active = 0;
+	}
+	kernir_7zaes_cbc_release(&zip->aes_cbc);
+	zip->aes_raw_remaining = 0;
+	if (zip->aes_buf != NULL)
+		kernir_aes_wipe(zip->aes_buf, zip->aes_buf_len);
+	zip->aes_buf_pos = zip->aes_buf_len = 0;
+}
+
+static void
+kernir_aes_folder_reset(struct _7zip *zip)
+{
+	kernir_aes_stream_stop(zip);
+	kernir_aes_wipe(zip->aes_streams, sizeof(zip->aes_streams));
+	zip->aes_folder = 0;
+	zip->aes_pack_base = 0;
+}
+
+static void
+kernir_aes_cleanup(struct _7zip *zip)
+{
+	unsigned i;
+
+	kernir_aes_folder_reset(zip);
+	if (zip->aes_buf != NULL) {
+		kernir_aes_wipe(zip->aes_buf, KERNIR_7Z_AES_BUF_SIZE);
+		free(zip->aes_buf);
+		zip->aes_buf = NULL;
+	}
+	for (i = 0; i < KERNIR_7Z_AES_KEYS; i++) {
+		struct kernir_7z_aes_key *k = &zip->aes_keys[i];
+
+		if (k->passphrase != NULL) {
+			kernir_aes_wipe(k->passphrase, strlen(k->passphrase));
+			free(k->passphrase);
+		}
+		kernir_aes_wipe(k, sizeof(*k));
+	}
+}
+
+/*
+ * The key for (params, passphrase): one SHA-256 chain of 2^cycles_power
+ * rounds per distinct salt and cost, not one per folder. 0 or -1.
+ */
 static int
+kernir_aes_get_key(struct _7zip *zip, const struct kernir_7zaes_params *p,
+    const char *passphrase, uint8_t key[KERNIR_7ZAES_KEY_SIZE])
+{
+	struct kernir_7z_aes_key *k;
+	unsigned i;
+
+	for (i = 0; i < KERNIR_7Z_AES_KEYS; i++) {
+		k = &zip->aes_keys[i];
+		if (k->passphrase != NULL &&
+		    k->cycles_power == p->cycles_power &&
+		    k->salt_size == p->salt_size &&
+		    memcmp(k->salt, p->salt, p->salt_size) == 0 &&
+		    strcmp(k->passphrase, passphrase) == 0) {
+			memcpy(key, k->key, KERNIR_7ZAES_KEY_SIZE);
+			return (0);
+		}
+	}
+	if (kernir_7zaes_derive_key(p, passphrase, key) != 0)
+		return (-1);
+
+	k = &zip->aes_keys[zip->aes_keys_next++ % KERNIR_7Z_AES_KEYS];
+	if (k->passphrase != NULL) {
+		kernir_aes_wipe(k->passphrase, strlen(k->passphrase));
+		free(k->passphrase);
+	}
+	kernir_aes_wipe(k, sizeof(*k));
+	k->passphrase = strdup(passphrase);
+	if (k->passphrase == NULL)
+		return (0);	/* Not cached; the key is still good. */
+	k->cycles_power = p->cycles_power;
+	k->salt_size = p->salt_size;
+	memcpy(k->salt, p->salt, p->salt_size);
+	memcpy(k->key, key, KERNIR_7ZAES_KEY_SIZE);
+	return (0);
+}
+
+static int
+kernir_aes_form_error(struct archive_read *a, int header)
+{
+	archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+	    "Unsupported form of 7zAES streams");
+	return (header ? ARCHIVE_FATAL : ARCHIVE_FAILED);
+}
+
+/*
+ * If *pfolder has 7zAES coders, record a key per encrypted packed stream
+ * and point *pfolder at a copy of the folder without those coders.
+ * Leaves the stream-reader state alone (and no key behind) on failure.
+ */
+static int
+kernir_aes_setup_folder(struct archive_read *a, struct _7z_folder **pfolder,
+    int header)
+{
+	struct _7zip *zip = a->format->data;
+	struct _7z_folder *f = *pfolder, *rf = &zip->aes_reduced;
+	struct kernir_7zaes_params params;
+	const char *passphrase = NULL;
+	size_t i, n_aes = 0;
+	const int fail = header ? ARCHIVE_FATAL : ARCHIVE_FAILED;
+	int r;
+
+	kernir_aes_folder_reset(zip);
+	for (i = 0; i < f->numCoders; i++)
+		if (f->coders[i].codec == _7Z_CRYPTO_AES_256_SHA_256)
+			n_aes++;
+	if (n_aes == 0)
+		return (ARCHIVE_OK);
+
+	zip->has_encrypted_entries = 1;
+	if (!header && a->entry)
+		archive_entry_set_is_data_encrypted(a->entry, 1);
+
+	if (f->numCoders > KERNIR_7Z_AES_MAX_CODERS ||
+	    f->numInStreams > KERNIR_7Z_AES_MAX_STREAMS ||
+	    f->numOutStreams > KERNIR_7Z_AES_MAX_STREAMS ||
+	    f->numBindPairs > KERNIR_7Z_AES_MAX_STREAMS ||
+	    f->numPackedStreams == 0 ||
+	    f->numPackedStreams > KERNIR_7Z_MAX_PACKED ||
+	    f->packIndex > zip->si.pi.numPackStreams ||
+	    f->numPackedStreams > zip->si.pi.numPackStreams - f->packIndex)
+		return (kernir_aes_form_error(a, header));
+
+	/* Work on a copy; properties stay owned by the original. */
+	*rf = *f;
+	rf->coders = zip->aes_coders;
+	rf->bindPairs = zip->aes_bind_pairs;
+	rf->unPackSize = zip->aes_unpack_sizes;
+	memcpy(rf->coders, f->coders, f->numCoders * sizeof(*f->coders));
+	if (f->numBindPairs)
+		memcpy(rf->bindPairs, f->bindPairs,
+		    f->numBindPairs * sizeof(*f->bindPairs));
+	memcpy(rf->unPackSize, f->unPackSize,
+	    f->numOutStreams * sizeof(*f->unPackSize));
+	for (i = 0; i < rf->numBindPairs; i++)
+		if (rf->bindPairs[i].inIndex >= rf->numInStreams ||
+		    rf->bindPairs[i].outIndex >= rf->numOutStreams)
+			return (kernir_aes_form_error(a, header));
+	for (i = 0; i < rf->numPackedStreams; i++)
+		if (rf->packedStreams[i] >= rf->numInStreams)
+			return (kernir_aes_form_error(a, header));
+
+	memset(&params, 0, sizeof(params));
+	for (;;) {
+		struct kernir_7z_aes_stream *st;
+		const struct _7z_coder *c;
+		size_t c_idx, in = 0, out = 0, k, bp, x;
+		int pr;
+
+		for (c_idx = 0; c_idx < rf->numCoders; c_idx++) {
+			if (rf->coders[c_idx].codec ==
+			    _7Z_CRYPTO_AES_256_SHA_256)
+				break;
+			in += rf->coders[c_idx].numInStreams;
+			out += rf->coders[c_idx].numOutStreams;
+		}
+		if (c_idx == rf->numCoders)
+			break;
+		c = &rf->coders[c_idx];
+		if (c->numInStreams != 1 || c->numOutStreams != 1)
+			goto form_failed;
+		/* Its input must be a packed stream ... */
+		for (k = 0; k < rf->numPackedStreams; k++)
+			if (rf->packedStreams[k] == in)
+				break;
+		if (k == rf->numPackedStreams || zip->aes_streams[k].encrypted)
+			goto form_failed;
+		/* ... and its output another coder's input (or the folder's),
+		 * through exactly one bind pair. */
+		bp = rf->numBindPairs;
+		for (i = 0; i < rf->numBindPairs; i++) {
+			if (rf->bindPairs[i].inIndex == in)
+				goto form_failed;
+			if (rf->bindPairs[i].outIndex != out)
+				continue;
+			if (bp != rf->numBindPairs)
+				goto form_failed;
+			bp = i;
+		}
+		if (bp == rf->numBindPairs && rf->numCoders != 1)
+			goto form_failed;
+
+		r = fail;
+		pr = kernir_7zaes_parse_props(c->properties,
+		    c->propertiesSize, &params);
+		if (pr == -2) {
+			archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
