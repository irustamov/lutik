+		/* The first passphrase only: never a passphrase loop. */
+		if (passphrase == NULL) {
+			__archive_read_reset_passphrase(a);
+			passphrase = __archive_read_next_passphrase(a);
+			if (passphrase == NULL) {
+				archive_set_error(&a->archive,
+				    ARCHIVE_ERRNO_MISC,
+				    "Passphrase required for this entry");
+				goto failed;
+			}
+		}
+		st = &zip->aes_streams[k];
+		if (kernir_aes_get_key(zip, &params, passphrase,
+		    st->key) != 0) {
+			archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+			    "Cannot derive the 7zAES key from the passphrase");
+			goto failed;
+		}
+		memcpy(st->iv, params.iv, sizeof(st->iv));
+		st->plain_size = rf->unPackSize[out];
+		st->encrypted = 1;
+
+		if (bp == rf->numBindPairs) {
+			/* AES alone: what it outputs is the folder. */
+			rf->coders[c_idx].codec = _7Z_COPY;
+			rf->coders[c_idx].propertiesSize = 0;
+			rf->coders[c_idx].properties = NULL;
+			break;
+		}
+		/* Drop the coder: its consumer reads packed stream k. */
+		x = rf->bindPairs[bp].inIndex;
+		memmove(&rf->bindPairs[bp], &rf->bindPairs[bp + 1],
+		    (rf->numBindPairs - bp - 1) * sizeof(*rf->bindPairs));
+		rf->numBindPairs--;
+		memmove(&rf->coders[c_idx], &rf->coders[c_idx + 1],
+		    (rf->numCoders - c_idx - 1) * sizeof(*rf->coders));
+		rf->numCoders--;
+		memmove(&rf->unPackSize[out], &rf->unPackSize[out + 1],
+		    (rf->numOutStreams - out - 1) * sizeof(*rf->unPackSize));
+		rf->numOutStreams--;
+		rf->numInStreams--;
+		for (i = 0; i < rf->numBindPairs; i++) {
+			if (rf->bindPairs[i].inIndex > in)
+				rf->bindPairs[i].inIndex--;
+			if (rf->bindPairs[i].outIndex > out)
+				rf->bindPairs[i].outIndex--;
+		}
+		rf->packedStreams[k] = x;
+		for (i = 0; i < rf->numPackedStreams; i++)
+			if (rf->packedStreams[i] > in)
+				rf->packedStreams[i]--;
+	}
+	kernir_aes_wipe(&params, sizeof(params));
+
+	zip->aes_folder = 1;
+	zip->aes_pack_base = rf->packIndex;
+	*pfolder = rf;
+	return (ARCHIVE_OK);
+form_failed:
+	r = kernir_aes_form_error(a, header);
+failed:
+	kernir_aes_wipe(&params, sizeof(params));
+	kernir_aes_wipe(zip->aes_streams, sizeof(zip->aes_streams));
+	return (r);
+}
+
+/* Called by seek_pack() once pack_stream_inbytes_remaining is set. */
+static int
+kernir_aes_stream_start(struct archive_read *a)
+{
+	struct _7zip *zip = a->format->data;
+	struct kernir_7z_aes_stream *st;
+	size_t k;
+
+	kernir_aes_stream_stop(zip);
+	if (!zip->aes_folder || zip->pack_stream_index < zip->aes_pack_base)
+		return (ARCHIVE_OK);
+	k = zip->pack_stream_index - zip->aes_pack_base;
+	if (k >= KERNIR_7Z_MAX_PACKED || !zip->aes_streams[k].encrypted)
+		return (ARCHIVE_OK);
+	st = &zip->aes_streams[k];
+
+	/* Ciphertext comes in whole blocks; anything else is damage. */
+	if (zip->pack_stream_inbytes_remaining % KERNIR_7ZAES_BLOCK_SIZE ||
+	    st->plain_size > zip->pack_stream_inbytes_remaining) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+		    "Damaged 7-Zip archive");
+		return (ARCHIVE_FATAL);
+	}
+	if (zip->aes_buf == NULL) {
+		zip->aes_buf = malloc(KERNIR_7Z_AES_BUF_SIZE);
+		if (zip->aes_buf == NULL) {
+			archive_set_error(&a->archive, ENOMEM,
+			    "No memory for 7-Zip decryption");
+			return (ARCHIVE_FATAL);
+		}
+	}
+	if (kernir_7zaes_cbc_init(&zip->aes_cbc, 0, st->key, st->iv) != 0) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+		    "Cannot start 7zAES decryption");
+		return (ARCHIVE_FATAL);
+	}
+	zip->aes_raw_remaining = zip->pack_stream_inbytes_remaining;
+	/* Callers see the plaintext stream: the AES coder's output size. */
+	zip->pack_stream_inbytes_remaining = st->plain_size;
+	zip->aes_active = 1;
+	return (ARCHIVE_OK);
+}
+
+/* Decrypts more ciphertext onto the end of aes_buf, up to `limit' bytes
+ * of buffer. 0 or -1 (truncated, or no room). */
+static int
+kernir_aes_decrypt_more(struct archive_read *a, size_t limit)
+{
+	struct _7zip *zip = a->format->data;
+	const void *p;
+	ssize_t avail;
+	size_t n;
+
+	if (zip->aes_raw_remaining <= 0 || zip->aes_buf_len >= limit)
+		return (-1);
+	n = (limit - zip->aes_buf_len) & ~(size_t)(KERNIR_7ZAES_BLOCK_SIZE - 1);
+	if ((uint64_t)n > (uint64_t)zip->aes_raw_remaining)
+		n = (size_t)zip->aes_raw_remaining;
+	p = __archive_read_ahead(a, KERNIR_7ZAES_BLOCK_SIZE, &avail);
+	if (p == NULL || avail < KERNIR_7ZAES_BLOCK_SIZE || n == 0)
+		return (-1);
+	if ((size_t)avail < n)
+		n = (size_t)avail & ~(size_t)(KERNIR_7ZAES_BLOCK_SIZE - 1);
+	if (kernir_7zaes_cbc_update(&zip->aes_cbc, p, n,
+	    zip->aes_buf + zip->aes_buf_len) != 0)
+		return (-1);
+	if (__archive_read_consume(a, n) < 0)
+		return (-1);
+	zip->stream_offset += n;
+	zip->aes_raw_remaining -= n;
+	zip->aes_buf_len += n;
+	return (0);
+}
+
+/*
+ * Like __archive_read_ahead(a, 1, avail) on the decrypted stream. Bytes
+ * past the plaintext (CBC padding) may be returned; callers clip to
+ * pack_stream_inbytes_remaining. *avail is 0 when the file is truncated.
+ */
+static const void *
+kernir_aes_read_ahead(struct archive_read *a, ssize_t *avail)
+{
+	struct _7zip *zip = a->format->data;
+
+	if (zip->aes_buf_pos == zip->aes_buf_len) {
+		zip->aes_buf_pos = zip->aes_buf_len = 0;
+		if (zip->aes_raw_remaining == 0 &&
+		    zip->pack_stream_inbytes_remaining == 0) {
+			/* Nothing left, and callers take none of it. */
+			*avail = 1;
+			return (zip->aes_buf);
+		}
+		if (kernir_aes_decrypt_more(a, KERNIR_7Z_AES_FILL) < 0) {
+			*avail = 0;
+			return (NULL);
+		}
+	}
+	*avail = (ssize_t)(zip->aes_buf_len - zip->aes_buf_pos);
+	return (zip->aes_buf + zip->aes_buf_pos);
+}
+
+/* Like __archive_read_ahead(a, offset + 1, NULL) on the decrypted stream,
+ * for PPMd's range decoder at a buffer boundary: the result points at the
+ * consume position. NULL if there are not offset + 1 bytes. */
+static const uint8_t *
+kernir_aes_peek(struct archive_read *a, size_t offset)
+{
+	struct _7zip *zip = a->format->data;
+
+	if (offset >= KERNIR_7Z_AES_BUF_SIZE)
+		return (NULL);
+	while (zip->aes_buf_len - zip->aes_buf_pos <= offset) {
+		if (zip->aes_buf_len + KERNIR_7ZAES_BLOCK_SIZE >
+		    KERNIR_7Z_AES_BUF_SIZE && zip->aes_buf_pos > 0) {
+			/* Make room. PPMd's input pointer is spent here. */
+			memmove(zip->aes_buf, zip->aes_buf + zip->aes_buf_pos,
+			    zip->aes_buf_len - zip->aes_buf_pos);
+			zip->aes_buf_len -= zip->aes_buf_pos;
+			zip->aes_buf_pos = 0;
+		}
+		if (kernir_aes_decrypt_more(a, KERNIR_7Z_AES_BUF_SIZE) < 0)
+			return (NULL);
+	}
+	return (zip->aes_buf + zip->aes_buf_pos);
+}
+
+static int
 skip_stream(struct archive_read *a, int64_t skip_bytes)
 {
 	struct _7zip *zip = a->format->data;
