+
+/*
+ * Kernir patch 0018: expat hands over the text of a base64 <name> in pieces
+ * that may end inside a 4-character group, so it is collected here, without
+ * whitespace (base64 may be wrapped), at most KERNIR_XAR_NAME_B64_CHARS of
+ * it, and decoded once, by kernir_xar_name_b64_end.
+ */
+static int
+kernir_xar_name_b64_collect(struct archive_read *a, const char *s,
+    size_t len)
+{
+	struct xar *xar = a->format->data;
+	size_t i, n;
+
+	xar->kernir_name_b64_pending = 1;
+	for (i = 0; i < len; i = n) {
+		n = i;
+		while (n < len && s[n] != ' ' && s[n] != '\t' &&
+		    s[n] != '\n' && s[n] != '\r')
+			n++;
+		if (n == i) {
+			n++;
+			continue;
+		}
+		if (archive_strlen(&(xar->kernir_name_b64text)) + (n - i) >
+		    KERNIR_XAR_NAME_B64_CHARS)
+			return (kernir_xar_refuse(a,
+			    "xar entry name is longer than 65536 bytes"));
+		archive_strncat(&(xar->kernir_name_b64text), s + i, n - i);
+	}
+	return (ARCHIVE_OK);
+}
+
+/*
+ * Kernir patch 0018: at </name>, decode the collected base64 name once into
+ * the pathname (with the parent prefix, as xml_data adds it to a plain
+ * name), then charge 0015's per-name and 0016's total limits on it.
+ */
+static int
+kernir_xar_name_b64_end(struct archive_read *a)
+{
+	struct xar *xar = a->format->data;
+	size_t used;
+
+	if (!xar->kernir_name_b64_pending)
+		return (ARCHIVE_OK);
+	xar->kernir_name_b64_pending = 0;
+	used = archive_strlen(&(xar->file->pathname));
+	if ((xar->file->has & HAS_PATHNAME) == 0) {
+		if (xar->file->parent != NULL) {
+			archive_string_concat(&(xar->file->pathname),
+			    &(xar->file->parent->pathname));
+			archive_strappend_char(&(xar->file->pathname), '/');
+		}
+		xar->file->has |= HAS_PATHNAME;
+	}
+	strappend_base64(xar, &(xar->file->pathname),
+	    xar->kernir_name_b64text.s,
+	    archive_strlen(&(xar->kernir_name_b64text)));
+	archive_string_empty(&(xar->kernir_name_b64text));
+	if (archive_strlen(&(xar->file->pathname)) > KERNIR_XAR_NAME_BYTES)
+		return (kernir_xar_refuse(a,
+		    "xar entry name is longer than 65536 bytes"));
+	xar->kernir_name_bytes += archive_strlen(&(xar->file->pathname)) - used;
+	if (xar->kernir_name_bytes >
+	    __archive_read_kernir_names_allowance(a, xar->kernir_files))
+		return (kernir_xar_refuse(a, "xar entry names and "
+		    "link targets take more than the names limit"));
+	return (ARCHIVE_OK);
 }
 
