--- a/libarchive/archive_read_support_format_tar.c
+++ b/libarchive/archive_read_support_format_tar.c
@@ -801,6 +801,25 @@
 				if (h != NULL && h[0] == 0 && archive_block_is_null(h))
 						__archive_read_consume(a, 512);
 
+				/* Kernir patch 0006: when tar reads through a filter
+				 * (gzip, bzip2, xz, uu, ...; the client reader alone
+				 * has no upstream), read the rest of the stream,
+				 * whatever it holds, so the filter reaches its trailer
+				 * and checks it. A filter error (a bad gzip CRC, a
+				 * truncated stream) fails the read with the filter's
+				 * message instead of turning into EOF. A plain tar
+				 * stops at its end blocks as upstream does: whatever
+				 * follows is not read, however long. */
+				while (a->filter != NULL && a->filter->upstream != NULL) {
+					ssize_t rest;
+					h = __archive_read_ahead(a, 1, &rest);
+					if (rest < 0)
+						return (ARCHIVE_FATAL);
+					if (h == NULL || rest == 0)
+						break;
+					__archive_read_consume(a, rest);
+				}
+
