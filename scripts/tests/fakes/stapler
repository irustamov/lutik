#!/bin/bash
# Fake `xcrun stapler` for tests. Never contacts Apple.
printf 'stapler %s\n' "$*" >> "${FAKE_LOG:-/dev/null}"
case "${1:-}" in
  staple|validate) [ -e "${2:-}" ] || { echo "fake stapler: no such file: ${2:-}" >&2; exit 2; } ;;
  *) echo "fake stapler: unsupported: $*" >&2; exit 2 ;;
esac
