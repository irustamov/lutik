{
    "sourceLanguage": "en",
    "strings": {
        "%@ (compatible, weak)": {
            "comment": "Label of an encryption scheme in the Encryption picker of the save options sheet when the scheme is old and weak but opens in more apps. %@ = the scheme's name (e.g. ZipCrypto), not translated.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "%@ (compatible, weak)"
                    }
                }
            }
        },
        "%@ copy": {
            "comment": "Default file name of a copy made with Save As Copy, without the extension (the app appends it). %@ = the original archive's name without its extension. Must stay a valid file name: no slashes or colons.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "%@ copy"
                    }
                }
            }
        },
        "%@\n%lld of %lld": {
            "comment": "Alert message of an extraction conflict question when there are several: %1$@ = the question's text (already translated, e.g. “Do you want to replace it with the one you’re extracting?”), then a new line and the position of this question: %2$lld = its number, %3$lld = how many conflicts there are in all (e.g. “2 of 5”).",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "%1$@\n%2$lld of %3$lld"
                    }
                }
            }
        },
        "%lld dropped items didn't provide files to copy.": {
            "comment": "Alert message under “Couldn't add %lld items” when dropped items (e.g. a text snippet or a link) offered no file to copy; any other dropped items are still added. %lld = number of those items. The English “one” form leaves the number out. Other languages’ “one” form can also cover 21, 31… and must then keep %lld.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "variations": {
                        "plural": {
                            "one": {
                                "stringUnit": {
                                    "state": "translated",
                                    "value": "The dropped item didn't provide a file to copy."
                                }
                            },
                            "other": {
                                "stringUnit": {
                                    "state": "translated",
                                    "value": "%lld dropped items didn't provide files to copy."
                                }
                            }
                        }
                    }
                }
            }
        },
        "%lld items from Photos didn't provide files to copy.": {
            "comment": "Alert message under “Couldn't add %lld items” when items picked in the Photos picker offered no file to copy; any other picked items are still added. %lld = number of those items. The English “one” form leaves the number out. Other languages’ “one” form can also cover 21, 31… and must then keep %lld.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "variations": {
                        "plural": {
                            "one": {
                                "stringUnit": {
                                    "state": "translated",
                                    "value": "The item from Photos didn't provide a file to copy."
                                }
                            },
                            "other": {
                                "stringUnit": {
                                    "state": "translated",
                                    "value": "%lld items from Photos didn't provide files to copy."
                                }
                            }
                        }
                    }
                }
            }
        },
        "%lld objects": {
            "comment": "Row detail of a folder in the item list (and its VoiceOver text): how many items it holds. %lld = number of items. In languages whose “one” form also covers 21, 31…, it must keep %lld.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "variations": {
                        "plural": {
                            "one": {
                                "stringUnit": {
                                    "state": "translated",
                                    "value": "%lld object"
                                }
                            },
                            "other": {
                                "stringUnit": {
                                    "state": "translated",
                                    "value": "%lld objects"
                                }
                            }
                        }
                    }
                }
            }
        },
        "Acknowledgements": {
            "comment": "Title of the screen listing open-source licenses and credits, and of the bar button that opens it. Noun.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Acknowledgements"
                    }
                }
            }
        },
        "Add": {
            "comment": "Toolbar menu (plus icon) at the bottom of an archive folder that adds files or photos to the archive. Verb.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Add"
                    }
                }
            }
        },
        "Adding files…": {
            "comment": "Progress sheet title while files dropped on the archive are copied in. The ellipsis shows work in progress.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Adding files…"
                    }
                }
            }
        },
        "Adding photos…": {
            "comment": "Progress sheet title while photos and videos picked in the Photos picker are copied into the archive. The ellipsis shows work in progress.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Adding photos…"
                    }
                }
            }
        },
        "Advanced": {
            "comment": "Disclosure group in the save options sheet that shows the less common settings (method, solid archive). Adjective used as a heading.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Advanced"
                    }
                }
            }
        },
        "An item named “%@” already exists in “%@”.": {
            "comment": "Alert title of an extraction conflict when an item to extract has the same name as one already in the destination folder. %1$@ = the item's name, %2$@ = the destination folder's name. The message under it asks whether to replace it.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "An item named “%1$@” already exists in “%2$@”."
                    }
                }
            }
        },
        "Ascending": {
            "comment": "A choice in More > Sort By: A to Z, oldest first, smallest first.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Ascending"
                    }
                }
            }
        },
        "Continue": {
            "comment": "iOS Welcome sheet: the button that closes the sheet and shows the file browser.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Continue"
                    }
                }
            }
        },
        "Couldn't add the folder": {
            "comment": "Alert title when adding a new folder to the archive (New Folder) fails; the reason is shown below it.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Couldn't add the folder"
                    }
                }
            }
        },
        "Couldn't rename “%@”": {
            "comment": "Alert title when renaming an item in the archive fails; the reason is shown below it. %@ = the item's name before the rename.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Couldn't rename “%@”"
                    }
                }
            }
        },
        "Date Modified": {
            "comment": "A choice in More > Sort By: order the list by the items' modification dates.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Date Modified"
                    }
                }
            }
        },
        "Descending": {
            "comment": "A choice in More > Sort By: Z to A, newest first, largest first.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Descending"
                    }
                }
            }
        },
        "Kind": {
            "comment": "A choice in More > Sort By: order the list by the items' kinds (PNG image, Folder…).",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Kind"
                    }
                }
            }
        },
        "Name": {
            "comment": "Placeholder of the text field in the Rename and New Folder alerts, where the item's new name is typed. Also a choice in More > Sort By: order the list by name.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Name"
                    }
                }
            }
        },
        "New Folder": {
            "comment": "Adds an empty folder to the archive, in the folder on screen: button in the ＋ menu, Shift-Command-N key command, and title of the alert that then asks for the new folder's name.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "New Folder"
                    }
                }
            }
        },
        "Open archives right here, or from Files: touch and hold an archive, tap Share, then choose %@.": {
            "comment": "iOS Welcome sheet: how to open an archive, under the feature rows. “Right here” is the app’s own file browser, shown when the sheet closes. Files is the iOS Files app; Share is its menu item. %@ = the app’s name.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Open archives right here, or from Files: touch and hold an archive, tap Share, then choose %@."
                    }
                }
            }
        },
        "Rename": {
            "comment": "Renames the item in the archive: button in a row's context menu, item in the File menu for the one item selected in Select mode, and title of the alert that asks for the new name.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Rename"
                    }
                }
            }
        },
        "SampleArchive.line1 %@": {
            "comment": "First line of the sample archive's read-me. %@ = the app's name.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Welcome to %@."
                    }
                }
            }
        },
        "SampleArchive.line2 %@": {
            "comment": "Second line of the sample archive's read-me. %@ = the app's name.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "In Files, touch and hold an archive, then tap Share and choose %@."
                    }
                }
            }
        },
        "SampleArchive.line3 %@": {
            "comment": "Third line of the sample archive's read-me. %@ = the app's name.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Or open %@ and browse to the archive."
                    }
                }
            }
        },
        "SampleArchive.name": {
            "comment": "File name of the sample archive put into the app's folder on first launch, without the extension (it becomes “Sample Archive.zip”). Avoid “/” and “:”.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Sample Archive"
                    }
                }
            }
        },
        "SampleArchive.readMeName": {
            "comment": "Name of the text file inside the sample archive, without the extension (it becomes “Read Me.txt”). Avoid “/” and “:”.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Read Me"
                    }
                }
            }
        },
        "Size": {
            "comment": "A choice in More > Sort By: order the list by size. Files go by their size; folders by the number of objects in them (the count their row shows), not by the total size of their contents as on the Mac.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Size"
                    }
                }
            }
        },
        "Sort By": {
            "comment": "Bar menu in More, and the title of its list of keys: how the folder list is ordered (Name, Date Modified, Size, Kind). Same on every level, kept across launches.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Sort By"
                    }
                }
            }
        },
        "Sort Order": {
            "comment": "The direction choices in More > Sort By (Ascending, Descending). Not shown as a title in the menu, but VoiceOver may read it.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Sort Order"
                    }
                }
            }
        },
        "“%@” and “%@” would get the same name in “%@”.": {
            "comment": "Alert title when two items in the archive differ only in letter case (Readme / README) and are extracted to a folder that ignores case, so the later one would take the earlier one's name. Neither is in the folder yet. %1$@ = the later item's name, %2$@ = the earlier item's name (either may be a file or a folder, or a path when the names alone read the same), %3$@ = the folder's name.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "“%1$@” and “%2$@” would get the same name in “%3$@”."
                    }
                }
            }
        },
        "Best (%lld)": {
            "comment": "Compression level of a ZIP or 7z archive in the Compression picker: the highest level, slowest and smallest result. %lld = the level number (e.g. 9). Keep the number in parentheses.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Best (%lld)"
                    }
                }
            }
        },
        "Cancel": {
            "comment": "Cancel button of alerts and sheets. It dismisses them without doing the action in the replace confirmation, the Extract Here alerts, the Mac metadata question, the password sheet, the new-archive and Save a Copy options sheet and the Text Encoding sheet, and it stops the running operation in the progress sheet. Verb.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Cancel"
                    }
                }
            }
        },
        "Choose Another Folder…": {
            "comment": "Button in the Extract Here alert when the chosen folder is on a read-only volume: opens the folder picker again. The ellipsis shows a picker follows.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Choose Another Folder…"
                    }
                }
            }
        },
        "Choose Files…": {
            "comment": "Item in the Add menu: opens the Files picker to choose files to add to the archive. The ellipsis shows a picker follows.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Choose Files…"
                    }
                }
            }
        },
        "Choose Folder…": {
            "comment": "Button on the screen shown when a split archive's other parts can't be read: opens the folder picker to grant access to the folder that holds all the parts. The ellipsis shows a picker follows.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Choose Folder…"
                    }
                }
            }
        },
        "Choose another folder to extract into.": {
            "comment": "Alert message under “%@ is on a read-only volume.” in Extract Here: nothing can be written there, so the user picks a different destination.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Choose another folder to extract into."
                    }
                }
            }
        },
        "Choose “%@” or a folder that contains it.": {
            "comment": "Extract Here alert message: %@ is the archive's folder as Files names it",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Choose “%@” or a folder that contains it."
                    }
                }
            }
        },
        "Close": {
            "comment": "Command in the menu bar of the archive window (⌘W) that closes the archive. Verb.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Close"
                    }
                }
            }
        },
        "Comment": {
            "comment": "Info sheet: title of the section showing the ZIP archive's comment, and the VoiceOver label of the comment field.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Comment"
                    }
                }
            }
        },
        "Compression": {
            "comment": "Pop-up in the save options sheet to choose how strongly the archive is compressed (a level). Noun.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Compression"
                    }
                }
            }
        },
        "Couldn't add %lld items": {
            "comment": "Alert title when dropped or picked items couldn't be added to the archive: the archive was busy (being saved or read again), or the items offered no file to copy. %lld = number of items. In languages whose “one” form also covers 21, 31…, it must keep %lld. The message under it says why.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "variations": {
                        "plural": {
                            "one": {
                                "stringUnit": {
                                    "state": "translated",
                                    "value": "Couldn't add %lld item"
                                }
                            },
                            "other": {
                                "stringUnit": {
                                    "state": "translated",
                                    "value": "Couldn't add %lld items"
                                }
                            }
                        }
                    }
                }
            }
        },
        "Couldn't add files": {
            "comment": "Alert title when adding files (from Files, Photos or a drop) to the archive failed. The message under it is the system's error.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Couldn't add files"
                    }
                }
            }
        },
        "Couldn't add “%@”": {
            "comment": "Alert title when a single item couldn't be added to the archive because it was busy (being saved or read again). %@ = the item's name. The message under it says to try again.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Couldn't add “%@”"
                    }
                }
            }
        },
        "Couldn't create the archive": {
            "comment": "Alert title when creating a new, empty archive failed. The message under it is the error.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Couldn't create the archive"
                    }
                }
            }
        },
        "Couldn't extract": {
            "comment": "Alert title when the folder picker failed while choosing where to extract. The message under it is the system's error.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Couldn't extract"
                    }
                }
            }
        },
        "Couldn't extract %lld items": {
            "comment": "Alert title when extracting several items failed. %lld = number of items. Never shown for a single item; in languages whose “one” form also covers 21, 31…, it still means several items.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "variations": {
                        "plural": {
                            "one": {
                                "stringUnit": {
                                    "state": "translated",
                                    "value": "Couldn't extract %lld item"
                                }
                            },
                            "other": {
                                "stringUnit": {
                                    "state": "translated",
                                    "value": "Couldn't extract %lld items"
                                }
                            }
                        }
                    }
                }
            }
        },
        "Couldn't extract “%@”": {
            "comment": "Alert title when extracting a single item failed. %@ = the item's name.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Couldn't extract “%@”"
                    }
                }
            }
        },
        "Couldn't open the folder": {
            "comment": "Alert title when the folder picker failed while choosing the folder that holds a split archive's other parts. The message under it is the system's error.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Couldn't open the folder"
                    }
                }
            }
        },
        "Couldn't open “%@”": {
            "comment": "Alert title when the archive couldn't be opened or read. %@ = the archive's file name.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Couldn't open “%@”"
                    }
                }
            }
        },
        "Couldn't preview “%@”": {
            "comment": "Alert title when an item in the archive couldn't be extracted to be previewed. %@ = the item's name.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Couldn't preview “%@”"
                    }
                }
            }
        },
        "Couldn't save a copy of “%@”": {
            "comment": "Alert title when Save As Copy failed. %@ = the archive's file name.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Couldn't save a copy of “%@”"
                    }
                }
            }
        },
        "Couldn't save “%@”": {
            "comment": "Alert title when saving the changes to the archive failed. %@ = the archive's file name.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Couldn't save “%@”"
                    }
                }
            }
        },
        "Couldn't share %lld items": {
            "comment": "Alert title when preparing several items to share failed. %lld = number of items. Never shown for a single item; in languages whose “one” form also covers 21, 31…, it still means several items.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "variations": {
                        "plural": {
                            "one": {
                                "stringUnit": {
                                    "state": "translated",
                                    "value": "Couldn't share %lld item"
                                }
                            },
                            "other": {
                                "stringUnit": {
                                    "state": "translated",
                                    "value": "Couldn't share %lld items"
                                }
                            }
                        }
                    }
                }
            }
        },
        "Couldn't share “%@”": {
            "comment": "Alert title when preparing a single item to share failed. %@ = the item's name.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Couldn't share “%@”"
                    }
                }
            }
        },
        "Create": {
            "comment": "Confirm button of the save options sheet when creating a new archive. Verb. Starts the creation.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Create"
                    }
                }
            }
        },
        "Delete": {
            "comment": "Remove the selected items from the archive: the Delete menu command (⌘⌫) and the Delete buttons of the item's menu and the toolbar. Verb. Not a permanent delete: it can be undone.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Delete"
                    }
                }
            }
        },
        "Do you want to replace it with the one you’re extracting?": {
            "comment": "Alert message of an extraction conflict when an item with the same name already exists in the destination. “it” = the existing item, named in the title. Buttons: Keep Both, Replace, Stop.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Do you want to replace it with the one you’re extracting?"
                    }
                }
            }
        },
        "Do you want to replace “%@” with “%@”?": {
            "comment": "Alert message under the case-only twin title (Readme / README). %1$@ = the earlier item's name, %2$@ = the later item's name; either may be a file or a folder. Buttons: Keep Both, Replace, Stop.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Do you want to replace “%1$@” with “%2$@”?"
                    }
                }
            }
        },
        "Done": {
            "comment": "Button that closes a sheet (Info, Acknowledgements) or leaves Select mode in the archive's toolbar. Verb.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Done"
                    }
                }
            }
        },
        "Encrypt with password": {
            "comment": "Switch in the save options sheet. On = the archive asks for a password to open.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Encrypt with password"
                    }
                }
            }
        },
        "Encryption": {
            "comment": "Pop-up in the save options sheet to choose the encryption scheme (e.g. AES-256). Noun.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Encryption"
                    }
                }
            }
        },
        "Enter Password": {
            "comment": "Navigation title of the sheet that asks for the password of an encrypted archive.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Enter Password"
                    }
                }
            }
        },
        "Extract": {
            "comment": "Toolbar menu in the archive's bottom bar that offers Extract Here and Extract To…. Verb. Extracts the selected items, or everything when none is selected.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Extract"
                    }
                }
            }
        },
        "Extract Here": {
            "comment": "Command that extracts the items next to the archive, into the folder that holds it. Verb. A menu item and a menu bar command.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Extract Here"
                    }
                }
            }
        },
        "Extract To…": {
            "comment": "Menu item that asks for a destination folder and extracts the items there. Verb. The ellipsis shows a picker follows.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Extract To…"
                    }
                }
            }
        },
        "Extracting %lld items…": {
            "comment": "Progress sheet title while several items are extracted. %lld = number of items. Never shown for a single item; in languages whose “one” form also covers 21, 31…, it still means several items. The ellipsis shows work in progress.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "variations": {
                        "plural": {
                            "one": {
                                "stringUnit": {
                                    "state": "translated",
                                    "value": "Extracting %lld item…"
                                }
                            },
                            "other": {
                                "stringUnit": {
                                    "state": "translated",
                                    "value": "Extracting %lld items…"
                                }
                            }
                        }
                    }
                }
            }
        },
        "Extracting “%@”…": {
            "comment": "Progress sheet title while a single item is extracted. %@ = the item's name. The ellipsis shows work in progress.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Extracting “%@”…"
                    }
                }
            }
        },
        "Fastest (%lld)": {
            "comment": "Compression level of a ZIP or 7z archive in the Compression picker: the lowest level, fastest and largest result. %lld = the level number (e.g. 0). Keep the number in parentheses.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Fastest (%lld)"
                    }
                }
            }
        },
        "Finder adds __MACOSX folders and ._ files to archives made on a Mac. Other apps don’t need them. Remove them, along with any .DS_Store files, when saving? Removed files can’t be restored. Lutik remembers your choice for this archive.": {
            "comment": "__MACOSX, ._ and .DS_Store are file names; don't translate.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Finder adds __MACOSX folders and ._ files to archives made on a Mac. Other apps don’t need them. Remove them, along with any .DS_Store files, when saving? Removed files can’t be restored. Lutik remembers your choice for this archive."
                    }
                }
            }
        },
        "Format": {
            "comment": "Pop-up in the save options sheet to choose the archive format (ZIP, 7z, …). Noun.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Format"
                    }
                }
            }
        },
        "Get Info": {
            "comment": "File menu command (⌘I) on iPad: opens the archive's Info sheet (format, size, items, comment), as Finder's Get Info.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Get Info"
                    }
                }
            }
        },
        "If the password is right, the archive may be damaged.": {
            "comment": "Hint under the “wrong password” error after the second wrong password in a row on a 7z archive: 7z has no password check, so damage looks like a wrong password.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "If the password is right, the archive may be damaged."
                    }
