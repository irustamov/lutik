        "Copy": {
            "comment": "Copies the item to the clipboard (it is extracted first, so it can be pasted here, in another archive or in Files): button in a row's context menu. The system's Edit > Copy (⌘C) copies the items selected in Select mode.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Copy"
                    }
                }
            }
        },
        "Cut": {
            "comment": "Cuts the item to the clipboard, to be moved by Paste in another folder of the same archive: button in a row's context menu. The system's Edit > Cut (⌘X) cuts the items selected in Select mode.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Cut"
                    }
                }
            }
        },
        "Paste": {
            "comment": "Pastes the clipboard's items into the folder on screen: copied or cut archive items, or files copied in another app. Item in the Add (＋) menu and in the menu a long press on empty space in the list shows.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Paste"
                    }
                }
            }
        },
        "Couldn't Copy": {
            "comment": "Alert title when copying archive items to the clipboard (Copy) fails; the reason is shown below it.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Couldn't Copy"
                    }
                }
            }
        },
        "Nothing on the clipboard can be pasted here.": {
            "comment": "Alert message under “Couldn't Paste” when the clipboard looked like it held files or copied archive items, but none could be pasted.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Nothing on the clipboard can be pasted here."
                    }
                }
            }
        },
        "ScreenState.pastedTextName": {
            "comment": "File name for a text file pasted (Paste) from the clipboard that has no name of its own. It becomes the file's name inside the archive, followed by the extension (e.g. “Pasted Text.txt”). Avoid “/” and “:”.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Pasted Text"
                    }
                }
            }
        },
        "Move To": {
            "comment": "Title of the sheet that lists the archive's folders after Move…, where the folder to move the items into is picked.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Move To"
                    }
                }
            }
        },
        "Move Here": {
            "comment": "Button of the Move To sheet that moves the items into the folder picked in its list.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Move Here"
                    }
                }
            }
        },
        "Couldn't move “%@”": {
            "comment": "Alert title when moving an item to another folder of the archive fails; the reason is shown below it. %@ = the item's name.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Couldn't move “%@”"
                    }
                }
            }
        },
        "There is already an item named “%@” there.": {
            "comment": "Alert message under “Couldn't move …” when a hidden item of the archive (Finder metadata, say) already has that name in the folder the items were moved to. %@ = that name.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "There is already an item named “%@” there."
                    }
                }
            }
        },
        "Couldn't move %lld items": {
            "comment": "Alert title when moving several items to another folder of the archive fails; the reason is shown below it. %lld = number of items. In languages whose “one” form also covers 21, 31…, it must keep %lld.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "variations": {
                        "plural": {
                            "one": {
                                "stringUnit": {
                                    "state": "translated",
                                    "value": "Couldn't move %lld item"
                                }
                            },
                            "other": {
                                "stringUnit": {
                                    "state": "translated",
                                    "value": "Couldn't move %lld items"
                                }
                            }
                        }
                    }
                }
            }
        },
        "Couldn't delete %lld items": {
            "comment": "Alert title when deleting items from the archive is refused; the reason is shown below it. %lld = number of items. In languages whose “one” form also covers 21, 31…, it must keep %lld.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "variations": {
                        "plural": {
                            "one": {
                                "stringUnit": {
                                    "state": "translated",
                                    "value": "Couldn't delete %lld item"
                                }
                            },
                            "other": {
                                "stringUnit": {
                                    "state": "translated",
                                    "value": "Couldn't delete %lld items"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "version": "1.0"
}
