            "comment": "Bar button (in More on iPhone) and its VoiceOver label, and the title of the sheet it opens: the archive's format, size, items and comment.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Info"
                    }
                }
            }
        },
        "Keep": {
            "comment": "Button in the “… contains Mac metadata” alert: saves the archive and keeps the Mac metadata (__MACOSX folders and ._ files) in it. Verb; the default button.",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Keep"
                    }
                }
            }
        },
        "Keep Both": {
            "comment": "Button in the extraction conflict alert: extract the item under a new name and keep the existing one. Verb.",
