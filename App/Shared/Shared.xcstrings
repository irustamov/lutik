          }
        }
      }
    },
    "Western (Windows Latin 1)": {
      "comment": "View > Text Encoding: Windows-1252",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Western (Windows Latin 1)"
          }
        }
      }
    },
    "Latin-US (DOS)": {
      "comment": "View > Text Encoding: CP437",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Latin-US (DOS)"
          }
        }
      }
    },
    "Central European (Windows Latin 2)": {
      "comment": "View > Text Encoding: Windows-1250",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Central European (Windows Latin 2)"
          }
        }
      }
    },
    "Reading “%@”…": {
      "comment": "Progress title while the archive is listed again after another text encoding was chosen (Text Encoding menu). %@ = the archive's file name. The ellipsis shows work in progress.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading “%@”…"
          }
        }
      }
    },
    "Part %lld of “%@” is missing.": {
      "comment": "Error title when a part of a split (multi-volume) archive can't be found. %1$lld = the missing part's number, %2$@ = the archive's name.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Part %lld of “%@” is missing."
          }
        }
      }
    },
    "The last part of “%@” is missing.": {
      "comment": "Error title when the last part of a split (multi-volume) archive can't be found. %@ = the archive's name.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last part of “%@” is missing."
          }
        }
      }
    },
    "This archive is split into parts.": {
      "comment": "Error title when Lutik may not read the other parts of a split (multi-volume) archive yet; the recovery suggestion asks for access to their folder.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This archive is split into parts."
          }
        }
      }
    },
    "Put all parts in one folder and open the archive again.": {
      "comment": "Recovery suggestion under “Part %lld of “%@” is missing.” and “The last part of “%@” is missing.”.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put all parts in one folder and open the archive again."
          }
        }
      }
    },
    "Lutik needs access to the folder that holds them.": {
      "comment": "Recovery suggestion under “This archive is split into parts.”: “them” = the archive's parts. Lutik is the app name.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lutik needs access to the folder that holds them."
          }
        }
      }
    },
    "That folder doesn't contain this archive's other parts.": {
      "comment": "Alert title after the user gave Lutik access to a folder that doesn't hold the split archive's other parts.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That folder doesn't contain this archive's other parts."
          }
        }
      }
    },
    "Choose the folder that holds all parts of this archive.": {
      "comment": "Message of the folder panel that asks for access to a split archive's parts, and of the alert after a wrong folder was chosen.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the folder that holds all parts of this archive."
          }
        }
      }
    },
    "Part %lld is still missing.": {
      "comment": "Alert title after access to the right folder was given but a part of the split archive is still missing. %lld = the missing part's number.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Part %lld is still missing."
          }
        }
      }
    },
    "The last part is still missing.": {
      "comment": "Alert title after access to the right folder was given but the split archive's last part is still missing.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last part is still missing."
          }
        }
      }
    },
    "Lutik still can't read the other parts.": {
      "comment": "Alert title after access to the right folder was given but the split archive's other parts still can't be read. Lutik is the app name.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lutik still can't read the other parts."
          }
        }
      }
    },
    "Make sure every part is downloaded and in this folder, then try again.": {
      "comment": "Alert message under “Part %lld is still missing.”, “The last part is still missing.” and “Lutik still can't read the other parts.”.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure every part is downloaded and in this folder, then try again."
          }
        }
      }
    },
    "A split archive can't be saved in place. Use Save As Copy.": {
      "comment": "Save error: a split (multi-volume) archive is read-only. “Save As Copy” is the command that saves a copy.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A split archive can't be saved in place. Use Save As Copy."
          }
        }
      }
    },
    "Exclude Mac metadata (.DS_Store, __MACOSX, ._ files)": {
      "comment": "Save options sheet (New Archive, Save As Copy): the switch that leaves Finder's metadata files out of the saved archive. .DS_Store, __MACOSX and ._ are file names: do not translate them.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclude Mac metadata (.DS_Store, __MACOSX, ._ files)"
          }
        }
      }
    },
    "Resource forks and extended attributes are never stored.": {
      "comment": "Save options sheet: footer under the Exclude Mac metadata switch. Resource forks and extended attributes are macOS file data that archives never keep.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resource forks and extended attributes are never stored."
          }
        }
      }
    },
    "Version %@ (%@)": {
      "comment": "About: the app's version line. The first value is the version (e.g. “0.1.0”), the second the build number and the commit (e.g. “1234, 9cc7108”).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@ (%@)"
          }
        }
      }
    },
    "Version %@": {
      "comment": "About: the app's version line when the build number is unknown. The value is the version (e.g. “0.1.0”).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@"
          }
        }
      }
    },
    "Build %@": {
      "comment": "About: the app's version line when the version is unknown. The value is the build number and the commit (e.g. “1234, 9cc7108”).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build %@"
          }
        }
      }
    },
    "Welcome to %@": {
      "comment": "Title of the Welcome screen (Mac window, iOS first-run sheet). %@ = the app’s name.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to %@"
          }
        }
      }
    },
    "Preview in Finder": {
      "comment": "Mac Welcome window: title of the feature row about the Quick Look preview of archives in Finder.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview in Finder"
          }
        }
      }
    },
    "Look inside an archive, then drag files out or extract them all.": {
      "comment": "Mac Welcome window: detail of the “Open and Extract” feature row.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look inside an archive, then drag files out or extract them all."
          }
        }
      }
    },
    "%@ couldn’t be made the default app for archives.": {
      "comment": "Mac Settings: making the app the default for archives failed. %@ = the app’s name.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ couldn’t be made the default app for archives."
          }
        }
      }
    },
    "Select an archive in Finder and press the Space bar to see what’s inside.": {
      "comment": "Mac Welcome window: detail of the “Preview in Finder” feature row (Quick Look shows the archive’s file list).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select an archive in Finder and press the Space bar to see what’s inside."
          }
        }
      }
    },
    "Open and Extract": {
      "comment": "Mac Welcome window: title of the feature row about opening archives and extracting files.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open and Extract"
          }
        }
      }
    },
    "Browse and Extract": {
      "comment": "iOS Welcome sheet: title of the feature row about browsing archives and extracting files.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browse and Extract"
          }
        }
      }
    },
    "Look inside an archive and save just the files you need.": {
      "comment": "iOS Welcome sheet: detail of the “Browse and Extract” feature row.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look inside an archive and save just the files you need."
          }
        }
