            "state": "translated",
            "value": "Common Formats"
          }
        }
      }
    },
    "Opens %@.": {
      "comment": "Welcome screen: detail of the “Common Formats” feature row. %@ = a list of format names ending in “more”, e.g. “ZIP, 7z, RAR, TAR, GZ, XZ, ISO, and more”.",
      "localizations": {
        "en": {
