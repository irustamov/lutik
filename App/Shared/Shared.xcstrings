    },
    "%@ couldn’t be made the default app for archives. Try again in Settings.": {
      "comment": "Mac Welcome window: making the app the default for archives failed. %@ = the app’s name. Settings is the app’s Settings window.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
